digraph G {

    rankdir=LR;

    {

        st_start [shape=circle,peripheries=2,style=filled, label="Start"]
        st_bgn [shape=circle,peripheries=2,color=lightblue,style=filled,label="st_bgn"]
        st_opr [shape=circle,peripheries=2,color=lightblue,style=filled,label="st_opr"]
        st_opd [shape=circle,peripheries=2,color=lightblue,style=filled,label="st_opd"]
        st_lps [shape=circle,peripheries=2,color=lightblue,style=filled,label="st_lps"]
        st_rps [shape=circle,peripheries=2,color=lightblue,style=filled,label="st_rps"]
        st_flg [shape=circle,peripheries=2,color=lightblue,style=filled,label="st_flg"]
        st_fnn [shape=circle,peripheries=2,color=lightblue,style=filled,label="st_fnn"]
        st_end [shape=circle,peripheries=2,style=filled,label="End"]

        st_start -> st_bgn;

        st_bgn -> st_opd[label="[.0-9]+"];
        st_bgn -> st_lps[label="("];
        st_bgn -> st_flg[label="+-"];
        st_bgn -> st_fnn[label="A-z_", color="red", fontcolor="red"];

        st_opd -> st_opr[label="+-*/^"];
        st_opd -> st_rps[label=")"];
        st_opd -> st_bgn[label=",", color="green", fontcolor="green"];
        st_opd -> st_end[label=""];

        st_opr -> st_opd[label="[.0-9]+"];
        st_opr -> st_lps[label="("];
        st_opr -> st_flg[label="+-"];
        st_opr -> st_fnn[label="A-z_", color="red", fontcolor="red"];

        st_lps -> st_opd[label="[.0-9]+"];
        st_lps -> st_lps[label="("];
        st_lps -> st_flg[label="+-"];
        st_lps -> st_fnn[label="A-z_", color="red", fontcolor="red"];

        st_rps -> st_opr[label="+-*/^"];
        st_rps -> st_rps[label=")"];
        st_rps -> st_bgn[label=",", color="green", fontcolor="green"];
        st_rps -> st_end[label=""];

        st_flg -> st_opd[label="[.0-9]+"];
        st_flg -> st_fnn[label="A-z_", color="red", fontcolor="red"];

        st_fnn -> st_fnn[label="[A-z0-9_]+", color="red", fontcolor="red"];
        st_fnn -> st_bgn[label="(", color="red", fontcolor="red"];
    }

    {
        rank = same;
        st_lps; st_rps;
    }
}
